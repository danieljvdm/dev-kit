{
  "name": "@danieljvdm/dev-kit",
  "version": "2.0.0",
  "private": false,
  "description": "Agent-led TypeScript repository setup and curated portable skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/dev-kit.git"
  },
  "bin": {
    "dev-kit": "bin/dev-kit.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "skill-sources.jsonc",
    "skill-sources.lock.json",
    "src/"
  ],
  "type": "module",
  "exports": {},
  "scripts": {
    "prepare": "./bin/dev-kit.mjs effect sync && ./bin/dev-kit.mjs tsgo patch && vp config --no-agent",
    "dev-kit": "./bin/dev-kit.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "vp lint",
    "gitignore": "./bin/dev-kit.mjs gitignore",
    "effect:sync": "./bin/dev-kit.mjs effect sync",
    "test": "vp test",
    "test:watch": "vitest --config vitest.config.ts",
    "tsgo:patch": "./bin/dev-kit.mjs tsgo patch",
    "catalog:refresh": "./bin/dev-kit.mjs catalog refresh",
    "catalog:check": "./bin/dev-kit.mjs catalog verify",
    "anti-slop:bundle": "vp pack src/oxlint-plugin-anti-slop/index.ts --out-dir .dev-kit/anti-slop-build --format esm --no-dts && node scripts/sync-anti-slop-runtime.mjs",
    "anti-slop:check": "vp pack src/oxlint-plugin-anti-slop/index.ts --out-dir .dev-kit/anti-slop-build --format esm --no-dts && node scripts/sync-anti-slop-runtime.mjs --check"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0-next.10",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "4.0.0-beta.107",
    "@oxlint/plugins": "1.78.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "25.9.1",
    "@types/semver": "7.8.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.107"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
